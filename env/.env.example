AI_SELLER_APP__NAME="AI Seller Agent"
AI_SELLER_APP__VERSION="0.1.0"
AI_SELLER_APP__HOST="127.0.0.1"
AI_SELLER_APP__PORT=8000
AI_SELLER_APP__RELOAD=false
AI_SELLER_APP__LOG_LEVEL="INFO"
AI_SELLER_APP__LOG_RENDERER="console"
AI_SELLER_APP__ENABLE_LOG_DIAGNOSTICS=false
AI_SELLER_APP__USE_UTC_TIMESTAMPS=true
AI_SELLER_APP__CATALOG_PATH="data/catalog_excel.csv"

AI_SELLER_MATCHING__MATCH_THRESHOLD=0.80
AI_SELLER_MATCHING__CANDIDATE_THRESHOLD=0.50
AI_SELLER_MATCHING__MINIMUM_MARGIN=0.10
AI_SELLER_MATCHING__CANDIDATES_LIMIT=3
AI_SELLER_MATCHING__TFIDF_WEIGHT=0.60
AI_SELLER_MATCHING__FUZZY_WEIGHT=0.25
AI_SELLER_MATCHING__FEATURE_WEIGHT=0.15
